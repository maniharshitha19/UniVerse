# ============================================================
#  Copy this file, rename the copy to ".env", and fill it in.
#  NEVER upload .env to GitHub (it's already in .gitignore).
# ============================================================

# --- Neon database (neon.tech → your project → "Connect") ---
# 1) Turn ON "Connection pooling" and copy the string here (host contains "-pooler"):
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# 2) Turn OFF "Connection pooling" and copy the string here (no "-pooler"):
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# --- Login tokens ---
# Any long random text. Person B MUST use the exact same value.
JWT_SECRET="replace-this-with-a-long-random-secret"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Cloudinary image uploads (optional, add later) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
